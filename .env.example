# Copie este arquivo para .env e preencha com os valores reais
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja3d
DB_USER=postgres
DB_PASS=sua_senha_do_postgres

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_aleatoria

ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque_esta_senha

# Produção: FLASK_DEBUG=0 e SESSION_COOKIE_SECURE=1 (site com HTTPS)
# Desenvolvimento local: FLASK_DEBUG=1 e SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
MAX_UPLOAD_MB=10

# E-mail do "esqueci a senha" (opcional). Crie uma conta grátis em brevo.com,
# valide o e-mail remetente e gere uma chave de API. Sem isso, o admin gera o link pelo painel.
BREVO_API_KEY=
EMAIL_REMETENTE=
